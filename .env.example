# ─────────────────────────────────────────────────────────────────────────────
# KLAPS · variables de entorno
# Copia este archivo como `.env` (o `.env.local`) y rellena los valores.
# `.env` NO se versiona: ver .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Frontend (Vite: todo lo que empieza por VITE_ es público) ────────────────
# Usuario del bot oficial, sin «@».
VITE_TELEGRAM_BOT_USERNAME=ai_klaps_bot
# URL de la función que guarda los chats y envía los mensajes.
VITE_TELEGRAM_API_URL=https://<project-ref>.supabase.co/functions/v1/klaps-telegram

# ── Servidor (Supabase Edge Function / función serverless) ──────────────────
# Estos NO llevan prefijo VITE_ y se configuran como secretos del servidor:
#   supabase secrets set TELEGRAM_BOT_TOKEN=... KLAPS_ALLOWED_ORIGIN=http://localhost:5173
# Nunca los pongas en el navegador ni en el repositorio.
# TELEGRAM_BOT_TOKEN=123456789:AA...
# KLAPS_ALLOWED_ORIGIN=http://localhost:5173
